@import url('project://database/Packages/spacewarp/Assets/UI/SpaceWarpUI.uss?fileID=7433441132597879392&guid=492f9c9847101cf4bab4ad09d8d46f3f&type=3#SpaceWarpUI');

.console-root {
    width: 1040px;
    height: 720px;
    min-width: 760px;
    min-height: 520px;
    padding: 10px;
    background-color: rgb(34, 38, 46);
    border-left-width: 1.2px;
    border-right-width: 1.2px;
    border-top-width: 1.2px;
    border-bottom-width: 1.2px;
    border-left-color: rgba(64, 67, 149, 0.5);
    border-right-color: rgba(64, 67, 149, 0.5);
    border-top-color: rgba(64, 67, 149, 0.5);
    border-bottom-color: rgba(64, 67, 149, 0.5);
    border-radius: 7px;
    color: rgb(230, 235, 244);
    overflow: hidden;
}

.title-bar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 54px;
    min-height: 54px;
    margin-top: 0;
    margin-bottom: 8px;
    overflow: visible;
}

#title-bar > .unity-button.unity-text-element {
    flex-shrink: 0;
}

.scope-tabs {
    flex-direction: row;
    background-color: rgb(25, 30, 39);
    border-radius: 6px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(55, 62, 76);
    border-right-color: rgb(55, 62, 76);
    border-top-color: rgb(55, 62, 76);
    border-bottom-color: rgb(55, 62, 76);
    padding: 3px;
    margin-bottom: 10px;
    flex-shrink: 0;
}

.scope-tab {
    flex-grow: 1;
    height: 34px;
    margin: 0 3px;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-radius: 4px;
    color: rgb(177, 189, 207);
    font-size: 14px;
    -unity-font-style: bold;
}

.scope-tab:hover {
    background-color: rgb(71, 78, 125);
    color: rgb(255, 255, 255);
}

.scope-tab-selected {
    background-color: rgb(75, 96, 115);
    color: rgb(255, 255, 255);
}

.console-panel {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
}

.console-toolbar {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
    flex-shrink: 0;
    min-width: 0;
}

.console-search-field {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-right: 10px;
}

.console-search-field .unity-base-field__label {
    min-width: 78px;
    color: rgb(177, 189, 207);
    -unity-font-style: bold;
}

.console-search-field .unity-base-field__input,
.console-search-field .unity-text-field__input {
    background-color: rgb(23, 28, 35);
    border-radius: 4px;
    color: rgb(230, 235, 244);
}

.console-action-button {
    min-width: 120px;
    height: 34px;
}

.console-filters {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    justify-content: space-between;
    flex-shrink: 0;
    min-width: 0;
    background-color: rgb(25, 30, 39);
    border-radius: 6px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(55, 62, 76);
    border-right-color: rgb(55, 62, 76);
    border-top-color: rgb(55, 62, 76);
    border-bottom-color: rgb(55, 62, 76);
    padding: 5px;
    margin-bottom: 10px;
}

.console-filter-group {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    flex-grow: 1;
    min-width: 0;
}

.console-filter-meta {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    justify-content: flex-end;
    flex-grow: 1;
    min-width: 0;
    margin-left: 10px;
    margin-top: 2px;
}

.console-summary-label {
    flex-shrink: 1;
    margin-right: 12px;
    padding: 0;
    color: rgb(177, 189, 207);
    font-size: 12px;
    -unity-font-style: bold;
    white-space: nowrap;
}

.console-level-chip {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    height: 30px;
    margin-right: 8px;
    padding: 0 10px;
    background-color: rgb(31, 37, 47);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(63, 70, 88);
    border-right-color: rgb(63, 70, 88);
    border-top-color: rgb(63, 70, 88);
    border-bottom-color: rgb(63, 70, 88);
    border-radius: 4px;
}

.console-level-chip:hover {
    background-color: rgb(41, 49, 62);
}

.console-level-chip-label {
    color: rgb(196, 205, 220);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 0.2px;
}

.console-level-chip-dot {
    width: 8px;
    height: 8px;
    margin-left: 8px;
    border-radius: 999px;
    background-color: rgb(140, 149, 167);
    display: none;
}

.console-level-chip-selected {
    background-color: rgb(43, 51, 64);
}

.console-level-chip-selected .console-level-chip-label {
    color: rgb(255, 255, 255);
}

.console-level-chip-selected .console-level-chip-dot {
    display: flex;
}

.console-level-debug {
    border-left-color: rgba(57, 59, 142, 0.65);
    border-right-color: rgba(57, 59, 142, 0.65);
    border-top-color: rgba(57, 59, 142, 0.65);
    border-bottom-color: rgba(57, 59, 142, 0.65);
}

.console-level-debug .console-level-chip-dot {
    background-color: rgb(93, 95, 184);
}

.console-level-debug.console-level-chip-selected {
    background-color: rgba(57, 59, 142, 0.2);
    border-left-color: rgb(93, 95, 184);
    border-right-color: rgb(93, 95, 184);
    border-top-color: rgb(93, 95, 184);
    border-bottom-color: rgb(93, 95, 184);
}

.console-level-info {
    border-left-color: rgba(1, 161, 255, 0.65);
    border-right-color: rgba(1, 161, 255, 0.65);
    border-top-color: rgba(1, 161, 255, 0.65);
    border-bottom-color: rgba(1, 161, 255, 0.65);
}

.console-level-info .console-level-chip-dot {
    background-color: rgb(84, 193, 255);
}

.console-level-info.console-level-chip-selected {
    background-color: rgba(1, 161, 255, 0.18);
    border-left-color: rgb(84, 193, 255);
    border-right-color: rgb(84, 193, 255);
    border-top-color: rgb(84, 193, 255);
    border-bottom-color: rgb(84, 193, 255);
}

.console-level-message {
    border-left-color: rgba(99, 99, 186, 0.65);
    border-right-color: rgba(99, 99, 186, 0.65);
    border-top-color: rgba(99, 99, 186, 0.65);
    border-bottom-color: rgba(99, 99, 186, 0.65);
}

.console-level-message .console-level-chip-dot {
    background-color: rgb(138, 138, 215);
}

.console-level-message.console-level-chip-selected {
    background-color: rgba(99, 99, 186, 0.2);
    border-left-color: rgb(138, 138, 215);
    border-right-color: rgb(138, 138, 215);
    border-top-color: rgb(138, 138, 215);
    border-bottom-color: rgb(138, 138, 215);
}

.console-level-warning {
    border-left-color: rgba(255, 228, 103, 0.7);
    border-right-color: rgba(255, 228, 103, 0.7);
    border-top-color: rgba(255, 228, 103, 0.7);
    border-bottom-color: rgba(255, 228, 103, 0.7);
}

.console-level-warning .console-level-chip-dot {
    background-color: rgb(255, 236, 144);
}

.console-level-warning.console-level-chip-selected {
    background-color: rgba(255, 228, 103, 0.18);
    border-left-color: rgb(255, 236, 144);
    border-right-color: rgb(255, 236, 144);
    border-top-color: rgb(255, 236, 144);
    border-bottom-color: rgb(255, 236, 144);
}

.console-level-error {
    border-left-color: rgba(255, 66, 72, 0.7);
    border-right-color: rgba(255, 66, 72, 0.7);
    border-top-color: rgba(255, 66, 72, 0.7);
    border-bottom-color: rgba(255, 66, 72, 0.7);
}

.console-level-error .console-level-chip-dot {
    background-color: rgb(255, 113, 118);
}

.console-level-error.console-level-chip-selected {
    background-color: rgba(255, 66, 72, 0.18);
    border-left-color: rgb(255, 113, 118);
    border-right-color: rgb(255, 113, 118);
    border-top-color: rgb(255, 113, 118);
    border-bottom-color: rgb(255, 113, 118);
}

.console-autoscroll {
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
}

.console-autoscroll-label {
    margin-right: 8px;
    color: rgb(196, 205, 220);
    font-size: 12px;
    -unity-font-style: bold;
}

.console-autoscroll-switch {
    margin-right: 0;
}

.console-autoscroll-switch > .unity-base-field__label.unity-text-element {
    display: none;
}

.console-container {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    padding: 8px;
    overflow: hidden;
}

.console-list-shell {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
}

.console-list {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    background-color: rgba(0, 0, 0, 0);
    overflow: hidden;
}

.console-list .unity-collection-view__item {
    width: 100%;
    padding: 0;
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.console-empty-state {
    margin-bottom: 8px;
    padding: 10px 12px;
    background-color: rgb(28, 34, 42);
    border-radius: 5px;
    color: rgb(177, 189, 207);
}

.console-row {
    width: 100%;
    min-width: 0;
    min-height: 50px;
    margin-bottom: 6px;
    padding: 6px 10px 7px;
    background-color: rgb(28, 34, 42);
    border-left-width: 4px;
    border-radius: 5px;
}

.console-row:hover {
    background-color: rgb(35, 42, 52);
}

.console-row-body {
    flex-direction: row;
    align-items: flex-start;
    min-width: 0;
}

.console-row-timestamp {
    margin-bottom: 3px;
    color: rgb(132, 145, 164);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 0.4px;
}

.console-row-source {
    flex-shrink: 0;
    max-width: 190px;
    margin-right: 8px;
    color: rgb(230, 235, 244);
    font-size: 13px;
    -unity-font-style: bold;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.console-row-message {
    width: 1px;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    color: rgb(222, 227, 236);
    font-size: 13px;
    white-space: normal;
    overflow: hidden;
}

.console-row-debug {
    border-left-color: rgb(57, 59, 142);
}

.console-row-info {
    border-left-color: rgb(1, 161, 255);
}

.console-row-message-level {
    border-left-color: rgb(99, 99, 186);
}

.console-row-warning {
    border-left-color: rgb(255, 228, 103);
}

.console-row-error {
    border-left-color: rgb(255, 66, 72);
}

.console-row-fatal {
    border-left-color: rgb(255, 0, 0);
}

.csharp-panel {
    flex-direction: row;
}

.csharp-main {
    flex-grow: 1;
    flex-shrink: 1;
    width: 1px;
    min-width: 0;
    min-height: 0;
    margin-right: 10px;
}

.csharp-editor-shell {
    height: 210px;
    flex-shrink: 0;
    padding: 8px;
    margin-bottom: 8px;
}

.csharp-code-field {
    flex-grow: 1;
    min-height: 0;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.csharp-code-field .unity-base-field__label {
    display: none;
}

.csharp-code-field .unity-base-field__input,
.csharp-code-field .unity-text-field__input {
    flex-grow: 1;
    min-height: 0;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-radius: 0;
    color: rgb(235, 240, 247);
    font-size: 13px;
    white-space: normal;
}

.csharp-actions {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    flex-shrink: 0;
    margin-bottom: 8px;
}

.csharp-action-button {
    margin-left: 8px;
}

.csharp-output-shell {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    padding: 8px;
}

.csharp-output-scroll {
    flex-grow: 1;
    min-height: 0;
    background-color: rgba(0, 0, 0, 0);
}

.csharp-output-scroll .unity-scroll-view__content-viewport,
.csharp-output-scroll .unity-scroll-view__content-container {
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.csharp-output {
    color: rgb(222, 227, 236);
    font-size: 13px;
    white-space: normal;
}

.cli-activity-shell {
    width: 360px;
    flex-shrink: 0;
    padding: 8px;
}

.cli-activity-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    margin-bottom: 8px;
}

.cli-activity-title {
    color: rgb(230, 235, 244);
    font-size: 15px;
    -unity-font-style: bold;
}

.cli-activity-list {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    background-color: rgba(0, 0, 0, 0);
    overflow: hidden;
}

.cli-activity-list .unity-collection-view__item {
    width: 100%;
    height: 104px;
    min-height: 104px;
    padding: 0;
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.cli-activity-list .unity-list-view__empty-label,
.cli-activity-list .unity-collection-view__empty-label {
    display: none;
}

.cli-activity-row {
    width: 100%;
    min-width: 0;
    height: 98px;
    min-height: 98px;
    max-height: 98px;
    margin-bottom: 6px;
    padding: 7px 8px;
    background-color: rgb(28, 34, 42);
    border-left-width: 4px;
    border-radius: 5px;
}

.cli-activity-row:hover {
    background-color: rgb(35, 42, 52);
}

.cli-activity-row-header {
    flex-direction: row;
    align-items: center;
    min-width: 0;
    margin-bottom: 4px;
}

.cli-activity-timestamp {
    color: rgb(132, 145, 164);
    font-size: 10px;
    -unity-font-style: bold;
    margin-right: 8px;
}

.cli-activity-source {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    color: rgb(230, 235, 244);
    font-size: 12px;
    -unity-font-style: bold;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.cli-activity-status {
    flex-shrink: 0;
    margin-left: 8px;
    padding: 2px 6px;
    border-radius: 4px;
    background-color: rgb(43, 51, 64);
    color: rgb(230, 235, 244);
    font-size: 11px;
    -unity-font-style: bold;
}

.cli-activity-command {
    color: rgb(222, 227, 236);
    font-size: 12px;
    -unity-font-style: bold;
    white-space: nowrap;
    margin-bottom: 3px;
    overflow: hidden;
    text-overflow: ellipsis;
}

.cli-activity-payload,
.cli-activity-result {
    color: rgb(177, 189, 207);
    font-size: 11px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.cli-activity-row-running {
    border-left-color: rgb(226, 196, 78);
}

.cli-activity-row-success {
    border-left-color: rgb(87, 171, 110);
}

.cli-activity-row-error {
    border-left-color: rgb(255, 66, 72);
}
